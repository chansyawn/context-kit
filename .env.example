# Clerk keys for the current environment.
CLERK_PUBLISHABLE_KEY=pk_test_replace-with-clerk-publishable-key
CLERK_SECRET_KEY=sk_test_replace-with-clerk-secret-key

# GitHub App slug used to build the installation URL.
GITHUB_APP_SLUG=contextkit-dev

# GitHub App OAuth client credentials used for user-to-server authorization.
GITHUB_APP_CLIENT_ID=replace-with-dev-github-app-client-id
GITHUB_APP_CLIENT_SECRET=replace-with-dev-github-app-client-secret

# Base64-encoded 32-byte key used to encrypt GitHub user access and refresh tokens.
# Generate with: openssl rand -base64 32
GITHUB_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key

# Cloudflare/D1 target environment. Use "development" locally; CI deploy sets "production".
CONTEXT_KIT_ENV=development

# Production D1 database id. Required only when CONTEXT_KIT_ENV is "production".
CONTEXT_KIT_D1_DATABASE_ID=00000000-0000-0000-0000-000000000000
