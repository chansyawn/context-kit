# Secret used by Better Auth to sign and encrypt auth data.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Public base URL for Better Auth callbacks and trusted origins.
BETTER_AUTH_URL=http://localhost:6173

# GitHub OAuth app client id used for local authentication.
GITHUB_CLIENT_ID=replace-with-dev-app-client-id

# GitHub OAuth app client secret used for local authentication.
GITHUB_CLIENT_SECRET=replace-with-dev-app-client-secret

# GitHub App slug used to build the installation URL.
GITHUB_APP_SLUG=contextkit-dev
